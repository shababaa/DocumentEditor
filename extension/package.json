{
  "name": "docuedit",
  "displayName": "DocuEdit",
  "description": "Generate editable DocuEdit documentation from files, folders, or an entire workspace.",
  "version": "0.1.0",
  "publisher": "docuedit",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:docuedit.generateDocumentation",
    "onCommand:docuedit.generateDocumentationFromCurrentFile",
    "onCommand:docuedit.generateDocumentationFromExplorer",
    "onCommand:docuedit.signIn",
    "onCommand:docuedit.signOut"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "docuedit.generateDocumentation",
        "title": "DocuEdit: Generate Documentation..."
      },
      {
        "command": "docuedit.generateDocumentationFromCurrentFile",
        "title": "DocuEdit: Generate Documentation from Current File"
      },
      {
        "command": "docuedit.generateDocumentationFromExplorer",
        "title": "DocuEdit: Generate Documentation from Selected Files"
      },
      {
        "command": "docuedit.signIn",
        "title": "DocuEdit: Sign In"
      },
      {
        "command": "docuedit.signOut",
        "title": "DocuEdit: Sign Out"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "docuedit.generateDocumentationFromExplorer",
          "when": "resourceScheme == file",
          "group": "navigation@100"
        }
      ],
      "editor/context": [
        {
          "command": "docuedit.generateDocumentationFromCurrentFile",
          "when": "editorTextFocus",
          "group": "navigation@100"
        }
      ]
    },
    "configuration": {
      "title": "DocuEdit",
      "properties": {
        "docuedit.backendApiBaseUrl": {
          "type": "string",
          "default": "http://localhost:5001",
          "description": "Base URL for the DocuEdit backend API."
        },
        "docuedit.webAppBaseUrl": {
          "type": "string",
          "default": "http://localhost:5173",
          "description": "Base URL for the DocuEdit web application."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "tsc -p ./ --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.7.2"
  }
}
